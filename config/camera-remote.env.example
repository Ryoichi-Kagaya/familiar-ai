# Second Tapo camera profile used through a Tailscale subnet router.
# Copy to .env.camera-remote and fill in the camera's LAN address and local account.
# CAMERA_HOST is the camera's LAN IP, not the subnet router's Tailscale 100.x address.
CAMERA_HOST=192.168.50.xxx
CAMERA_USERNAME=your-camera-local-user
CAMERA_PASSWORD="your-camera-local-password"
CAMERA_ONVIF_PORT=2020

# Optional when RTSP and ONVIF/PTZ use different endpoints.
# CAMERA_PTZ_HOST=192.168.50.xxx
# CAMERA_PTZ_USERNAME=your-camera-local-user
# CAMERA_PTZ_PASSWORD="your-camera-local-password"
# CAMERA_PTZ_PORT=2020

# Keep audio on this computer unless remote camera audio is intentionally configured.
STT_INPUT=local
TTS_OUTPUT=local
# CAMERA_TAPO_PASSWORD="your-tp-link-cloud-password"
# GO2RTC_STREAM=tapo_cam_remote
